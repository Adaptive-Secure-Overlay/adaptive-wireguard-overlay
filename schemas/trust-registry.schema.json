{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/candidate/wg-trust-registry.schema.json",
  "title": "Authenticated WireGuard node key registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["signed", "signature"],
  "properties": {
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "registry_id", "version", "nodes"],
      "properties": {
        "schema_version": { "const": 1 },
        "registry_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 4096,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["public_key"],
            "properties": {
              "public_key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]{43}=$"
              }
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "sshsig-ed25519" },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "value": {
          "type": "string",
          "pattern": "^-----BEGIN SSH SIGNATURE-----\\n[A-Za-z0-9+/=\\n]+\\n-----END SSH SIGNATURE-----\\n?$"
        }
      }
    }
  }
}
