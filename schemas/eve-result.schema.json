{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/wg-overlay-eve-result.schema.json",
  "title": "WireGuard overlay EVE-NG case result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "suite", "case_id", "src", "dst", "conn", "ok",
    "status", "wg_up_code", "handshake_ok", "ping_ok", "wg_data_packets",
    "direct_wg_control_packets", "wg_up_seconds", "route", "x1", "x2",
    "conn_id", "x1_is_dst", "x2_is_src", "x2_is_dst", "abab",
    "up_tail", "ping_tail", "criteria", "metrics_ms", "evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "suite": { "enum": ["bidir12", "disjoint5", "ring10", "reverse5"] },
    "case_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "src": { "type": "string", "minLength": 1, "maxLength": 128 },
    "dst": { "type": "string", "minLength": 1, "maxLength": 128 },
    "conn": { "type": "string", "minLength": 1, "maxLength": 128 },
    "ok": { "type": "boolean" },
    "status": { "enum": ["pass", "fail"] },
    "wg_up_code": { "type": "integer" },
    "handshake_ok": { "type": "boolean" },
    "ping_ok": { "type": "boolean" },
    "wg_data_packets": { "type": "integer", "minimum": 0 },
    "direct_wg_control_packets": { "type": "integer", "minimum": 0 },
    "wg_up_seconds": { "type": "number", "minimum": 0 },
    "route": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "x1": { "type": "string", "minLength": 1, "maxLength": 128 },
    "x2": { "type": "string", "minLength": 1, "maxLength": 128 },
    "conn_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "x1_is_dst": { "type": "boolean" },
    "x2_is_src": { "type": "boolean" },
    "x2_is_dst": { "type": "boolean" },
    "abab": { "type": "boolean" },
    "up_tail": { "type": "string", "maxLength": 4096 },
    "ping_tail": { "type": "string", "maxLength": 4096 },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handshake_fresh", "useful_traffic_ok", "control_types_overlay_only",
        "transport_type4_direct_only", "reverse_route_ok", "redaction_confirmed"
      ],
      "properties": {
        "handshake_fresh": { "type": "boolean" },
        "useful_traffic_ok": { "type": "boolean" },
        "control_types_overlay_only": { "type": "boolean" },
        "transport_type4_direct_only": { "type": "boolean" },
        "reverse_route_ok": { "type": "boolean" },
        "redaction_confirmed": { "type": "boolean" }
      }
    },
    "metrics_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_setup_ms", "handshake_ms", "first_data_ms"],
      "properties": {
        "route_setup_ms": { "type": "number", "minimum": 0 },
        "handshake_ms": { "type": "number", "minimum": 0 },
        "first_data_ms": { "type": "number", "minimum": 0 },
        "rekey_ms": { "type": "number", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event", "message_type"],
            "properties": {
              "event": {
                "enum": ["CAPTURE", "ROUTE_READY", "SEND", "ARRIVE", "INJECT", "DIRECT", "DROP"]
              },
              "message_type": { "enum": [1, 2, 3, 4] },
              "capture_id": { "type": "string", "maxLength": 128 }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pass" } }, "required": ["status"] },
      "then": {
        "properties": {
          "ok": { "const": true },
          "wg_up_code": { "const": 0 },
          "handshake_ok": { "const": true },
          "ping_ok": { "const": true },
          "wg_data_packets": { "minimum": 2 },
          "direct_wg_control_packets": { "const": 0 },
          "criteria": {
            "properties": {
              "handshake_fresh": { "const": true },
              "useful_traffic_ok": { "const": true },
              "control_types_overlay_only": { "const": true },
              "transport_type4_direct_only": { "const": true },
              "reverse_route_ok": { "const": true },
              "redaction_confirmed": { "const": true }
            }
          }
        }
      }
    }
  ]
}
