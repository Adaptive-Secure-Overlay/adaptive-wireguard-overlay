FROM python:3.14-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    wireguard-tools nftables iproute2 tcpdump iputils-ping iperf3 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir cryptography==50.0.2
WORKDIR /app
COPY research/mcc-e2e-20261015/candidate/ /app/
COPY src/wg_handshake_overlay/ /app/wg_handshake_overlay/
COPY linux-kernel-wg-backend/wan_py_daemon.py /app/
COPY linux-kernel-wg-backend/wan_py_wg_daemon.py /app/
COPY linux-kernel-wg-backend/wg_proxy_nft_apply.sh /usr/local/bin/wg_proxy_nft_apply.sh
RUN chmod +x /usr/local/bin/wg_proxy_nft_apply.sh
ENV PYTHONPATH=/app
